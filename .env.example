# Copy this file to .env and fill in REAL values there.
# NEVER put real secrets in this file (.env.example) — it is tracked by git.
# .env itself is gitignored and must never be committed.

# --- Reddit API (praw) ---
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Tiingo (news with publication dates + coverage volume) ---
# Free key: https://www.tiingo.com  (register, then Account -> API Token)
# NOTE: Tiingo's News API is a PAID add-on. A free key works for prices and
# fundamentals but returns HTTP 403 for news, so the pipeline skips it.
TIINGO_API_KEY=

# --- Finnhub (company news, free tier includes news) ---
# Free key: https://finnhub.io/register
# This is the preferred news source: it returns an explicit date range, which is
# what makes recency weighting and coverage-volume tracking possible.
FINNHUB_API_KEY=

# SEC EDGAR asks every client to identify itself with a name and contact email.
SEC_USER_AGENT=
